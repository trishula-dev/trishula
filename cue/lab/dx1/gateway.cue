package dx1

files: "dx1-gateway.yaml": {
	header: """
		# Gateway provisioned by the NGF helm release (dx1 in the nginx-gateway
		# ns); this manifest is kept for the committed lab record and for clusters
		# where the operator provisions it separately. The release sets
		# service.type=NodePort with a pinned nodePort 31437 for listener :80.
		#
		# TR-203 L4 (issue #264, decision 4): the https listener is the lab
		# terminator's TLS leg. setup.sh creates the dx1-lab-tls Secret (the
		# self-signed lab fixture pair; never a product cert) before this
		# manifest applies. The hybrid key exchange comes with the data
		# plane's TLS stack. The read:
		#   bash lab/dx1/pqc-termination-read.sh
		#
		# Generated by internal/cuegen from cue/lab/dx1 (TR-46, issue #192): hand
		# edits fail the golden-diff gate; change the CUE source instead.
		"""
	objects: [{
		apiVersion: "gateway.networking.k8s.io/v1"
		kind:       "Gateway"
		metadata: {
			name:      "edge-gateway"
			namespace: "nginx-gateway"
		}
		spec: {
			gatewayClassName: "nginx"
			listeners: [{
				name:     "http"
				port:     80
				protocol: "HTTP"
				hostname: "*.dx1.example.com"
				allowedRoutes: {
					kinds: [{
						group: "gateway.networking.k8s.io"
						kind:  "HTTPRoute"
					}]
					namespaces: {
						from: "All"
					}
				}
			}, {
				name:     "https"
				port:     443
				protocol: "HTTPS"
				hostname: "*.dx1.example.com"
				tls: {
					mode: "Terminate"
					certificateRefs: [{
						kind: "Secret"
						name: "dx1-lab-tls"
					}]
				}
				allowedRoutes: {
					kinds: [{
						group: "gateway.networking.k8s.io"
						kind:  "HTTPRoute"
					}]
					namespaces: {
						from: "All"
					}
				}
			}]
		}
	}]
}
