// The lab rule pack for the S3 claims gate (TR-198, issue #240): the
// configmap the auth policy's ruleSets resolve to (data key pack.yaml).
// The pack carries the vocabulary's membership example behind the verified
// gate and the HS256 verifier bundle the operator supplies (the optional
// in-engine verify; the fixture key is a lab value, never a secret).
package dx1

files: "dx1-rulepack-auth.yaml": {
	header: """
		# TR-198 (issue #240) — the S3 claims-policy content source: the ConfigMap
		# the auth policy's ruleSets[0].name (dx1-auth) resolves to, in the policy's
		# namespace with data key pack.yaml (cmd/operator's cmSource). The rule is
		# the vocabulary's membership example over /orders/* behind the verified
		# gate: verified=false or a missing read:orders scope denies (block,
		# policy-selected). The pack also carries the optional in-engine verifier
		# bundle: the HS256 key the consult verifies the bearer token against (the
		# operator supplies; the value is a lab fixture, never a secret).
		#
		# Generated by internal/cuegen from cue/lab/dx1 (TR-46, issue #192): hand
		# edits fail the golden-diff gate; change the CUE source instead.
		"""
	objects: [{
		apiVersion: "v1"
		kind:       "ConfigMap"
		metadata: {
			name:      "dx1-auth"
			namespace: "dx1"
			labels: {
				"app.kubernetes.io/part-of": "trishula-dx1-lab"
			}
		}
		data: "pack.yaml": """
			verifier:
			  hs256SecretsHex:
			    - 3c6fa2e5b19d4c718fa2d5e9b0c874a1
			rules:
			  - id: auth:scope_insufficient
			    name: orders-read-claims-gate
			    description: >-
			      Gates /orders/* on a verified identity carrying read:orders
			      (the record's membership example; verified=false gates the
			      allow path).
			    action: enforce
			    expression: |
			      path.matches("/orders/*") &&
			      (!request.auth.verified || !("read:orders" in request.auth.scopes))

			"""
	}]
}
