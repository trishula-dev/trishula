// The lab WAFPolicy for the S3 claims gate (TR-198, issue #240): the CR
// the operator compiles (defaultAction pass; the enforced vocabulary rule
// is the blocking leg; the seed pack rides every bundle).
package dx1

files: "dx1-wafpolicy-auth.yaml": {
	header: """
		# TR-198 (issue #240) — the WAFPolicy CR the lab compiles and consults for
		# the S3 claims gate, on the dx1-engine-route route class (the CRD is
		# manifests/crd/wafpolicy-crd.yaml, TR-08a).
		#
		# Effects in the lab (verified by lab/dx1/dx1-auth.sh):
		#   - the vocabulary rule auth:scope_insufficient (configmap dx1-auth,
		#     data pack.yaml) gates /orders/*: a request whose bearer token does
		#     not verify, or whose verified identity lacks the read:orders scope,
		#     is blocked (403, X-Trishula-Decision: block, the rule id named);
		#   - a verified identity carrying read:orders forwards (defaultAction
		#     pass) — the allow path is gated, not the route.
		# The seed rule pack (TR-02's TR02-001 rate-shape, action=log, never
		# enforces alone) embeds in every compiled bundle.
		#
		# Generated by internal/cuegen from cue/lab/dx1 (TR-46, issue #192): hand
		# edits fail the golden-diff gate; change the CUE source instead.
		"""
	objects: [{
		apiVersion: "trishula.security/v1alpha1"
		kind:       "WAFPolicy"
		metadata: {
			name:      "orders-read-gate"
			namespace: "dx1"
			labels: {
				"app.kubernetes.io/part-of": "trishula-dx1-lab"
			}
		}
		spec: {
			defaultAction: "pass"
			modeFlags: {
				inline: true
				shield: false
				shadow: true
			}
			ruleSets: [{
				name: "dx1-auth"
				source: {
					crsVersion: "4.x"
					profile:    "PL1"
				}
			}]
		}
	}]
}
