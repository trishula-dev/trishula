// Package seedpack owns the CEL seed rule pack (TR-02; spec v4 section 19
// `rules/cel/` + the section 11.3 example). internal/cuegen derives BOTH
// committed copies from the `pack` value: rules/cel/seed.yaml (the canonical
// file the CLI surfaces read) and internal/operator/seed_pack.yaml (the
// go:embed copy the deployed operator compiles from), byte-identical
// (internal/operator/seedpack_test.go guards the equality). A change to the
// pack is a change here, never in the derived files: the golden-diff gate
// rejects hand edits to them.
// TR-46 (issue #192), census rows "CEL seed rules" and "Operator seed
// pack" — both CUE-owned.
package seedpack

// Rule is one CEL rule of the pack (the engine's rule wire, section 11.3):
// id, name, description, action, expression.
#Rule: {
	id:          string
	name:        string
	description: string
	action:      "block" | "challenge" | "log" | "pass"
	expression:  string
}

#Pack: {rules: [...#Rule]}

// pack is the derived-content source of both committed copies.
pack: #Pack
pack: {
	rules: [{
		id:          "TR02-001"
		name:        "chat-completions-rate-shape"
		description: "Feeds the section 13 ladder: POST chat-completions above 40 requests per 5 min window scores toward the ban decision."
		action:      "log"
		expression: """
			request.method == "POST" &&
			path.matches("/v1/chat/*") &&
			request.rate_windows["5m"].requests > 40

			"""
	}]
}

// header is the comment block the derivations prepend (provenance only; it
// never carries data).
header: """
	# Trishula seed CEL rule pack (TR-02; spec v4 section 19 `rules/cel/` + section 11.3 examples).
	# Exactly one rule at v0: the section 11.3 rate-shape example, expression verbatim,
	# action=log. Ladder position (section 11.3): evaluation is a scoring input to the
	# section 13 ladder — v0 verdicts are log-only; enforcement lands with the
	# ScoredWindowBan engine (TR-09/TR-10).
	#
	# Generated by internal/cuegen from cue/seedpack (TR-46, issue #192): hand
	# edits fail the golden-diff gate; change the CUE source instead.
	"""
